/* =========================================================
   SUZINI — BT250 DOUBLE MIXTE
   Header tournoi

   Charte "Les vendredis du BT Suzini"
========================================================= */


/* ==============================
   HEADER FIXE
============================== */

#siteHeader{
  position:sticky;

  top:0;

  z-index:9999;
}


.site-header{
  background:
    rgba(255,255,255,.97);

  backdrop-filter:
    blur(14px);

  -webkit-backdrop-filter:
    blur(14px);

  border-bottom:
    3px solid var(--orange);

  box-shadow:
    0 3px 14px rgba(0,0,0,.06);
}


/* ==============================
   PARTIE HAUTE
============================== */

.header-top{
  height:58px;

  padding:
    5px 12px;

  display:grid;

  grid-template-columns:
    48px
    minmax(0,1fr)
    48px;

  align-items:center;

  gap:8px;
}


/* ==============================
   LOGOS
============================== */

.header-logo{
  width:46px;
  height:46px;

  display:flex;

  align-items:center;
  justify-content:center;
}


.header-logo img{
  width:100%;
  height:100%;

  object-fit:contain;
}


.header-logo-right{
  justify-self:end;
}


/* ==============================
   TITRE TOURNOI
============================== */

.header-event{
  min-width:0;

  text-align:center;

  line-height:1;
}


.header-event span{
  display:block;

  margin-bottom:4px;

  overflow:hidden;

  color:var(--orange);

  font-size:8px;

  font-weight:900;

  letter-spacing:1.15px;

  text-transform:uppercase;

  text-overflow:ellipsis;

  white-space:nowrap;
}


.header-event strong{
  display:block;

  overflow:hidden;

  color:var(--black);

  font-size:17px;

  font-weight:950;

  text-overflow:ellipsis;

  white-space:nowrap;
}


/* ==============================
   NAVIGATION
============================== */

.main-nav-shell{
  position:relative;

  width:100%;

  overflow:hidden;

  background:#fff;

  border-top:
    1px solid #eeeeee;
}


.main-nav{
  display:flex;

  flex-direction:row;

  flex-wrap:nowrap;

  align-items:stretch;

  justify-content:flex-start;

  gap:4px;

  width:100%;

  max-width:100%;

  height:50px;

  overflow-x:auto;
  overflow-y:hidden;

  padding:
    4px 28px 5px;

  scroll-behavior:smooth;

  scrollbar-width:none;

  -webkit-overflow-scrolling:touch;

  overscroll-behavior-x:contain;
}


.main-nav::-webkit-scrollbar{
  display:none;
}


/* ==============================
   ONGLETS
============================== */

.main-nav > a{
  flex:
    0 0 auto;

  min-width:74px;

  display:flex;

  flex-direction:column;

  align-items:center;

  justify-content:center;

  gap:1px;

  color:#666;

  font-size:8px;

  font-weight:850;

  white-space:nowrap;
}


.nav-icon{
  flex:0 0 auto;

  font-size:16px;

  line-height:1;
}


.nav-label{
  display:block;

  overflow:hidden;

  text-overflow:ellipsis;

  white-space:nowrap;
}


/* ==============================
   ONGLET ACTIF
============================== */

.main-nav > a.active{
  color:
    var(--orange);
}


/* ==============================
   BASCULE ADMIN
============================== */

.admin-switch{
  cursor:pointer;

  -webkit-tap-highlight-color:
    transparent;
}


/* ==============================
   FLÈCHES
============================== */

.nav-scroll-arrow{
  position:absolute;

  z-index:30;

  top:50%;

  transform:
    translateY(-50%);

  width:25px;
  height:38px;

  padding:0;

  border:0;

  display:flex;

  align-items:center;
  justify-content:center;

  background:
    rgba(255,255,255,.94);

  color:#111;

  font-size:25px;

  font-weight:1000;

  line-height:1;

  cursor:pointer;
}


.nav-scroll-arrow[hidden]{
  display:none !important;
}


.nav-scroll-left{
  left:0;

  background:
    linear-gradient(
      90deg,
      #ffffff 60%,
      rgba(255,255,255,.80)
    );
}


.nav-scroll-right{
  right:0;

  background:
    linear-gradient(
      270deg,
      #ffffff 60%,
      rgba(255,255,255,.80)
    );
}


/* ==============================
   TOUCH
============================== */

.main-nav a:active{
  transform:
    scale(.97);
}


/* ==============================
   TABLETTE / DESKTOP
============================== */

@media(min-width:701px){

  .header-top,
  .main-nav{
    max-width:
      var(--container);

    margin:
      0 auto;
  }

}
